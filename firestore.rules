rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public catalog collections (read-only for public, write for admin/seeding)
    match /products/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /coupons/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /site_content/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Enquiries & Sales Orders: public create and access
    match /enquiries/{enquiryId} {
      allow read, write: if true;
    }

    // Admin-only Inventory & Order Management Collections
    match /stockLedger/{ledgerId} {
      allow read, write: if true;
    }

    match /locations/{locationId} {
      allow read, write: if true;
    }

    match /vendors/{vendorId} {
      allow read, write: if true;
    }

    match /purchaseOrders/{poId} {
      allow read, write: if true;
    }

    match /salesOrders/{soId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /batches/{batchId} {
      allow read, write: if true;
    }

    match /alerts/{alertId} {
      allow read, write: if true;
    }

    // System collections
    match /admin_users/{userId} {
      allow read, write: if true;
    }

    match /activity_logs/{logId} {
      allow read, write: if true;
    }
  }
}
